---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProposalHeader from '../../components/proposals/ProposalHeader.astro';
import ProposalHero from '../../components/proposals/ProposalHero.astro';
import StartingPoint from '../../components/proposals/StartingPoint.astro';
import PresenceJourney from '../../components/proposals/PresenceJourney.astro';
import StructurePreview from '../../components/proposals/StructurePreview.astro';
import RecommendationReason from '../../components/proposals/RecommendationReason.astro';
import ClientResponsibilities from '../../components/proposals/ClientResponsibilities.astro';
import GoogleBusinessCare from '../../components/proposals/GoogleBusinessCare.astro';
import DeliveryProcess from '../../components/proposals/DeliveryProcess.astro';
import MonthlyResponsibility from '../../components/proposals/MonthlyResponsibility.astro';
import InvestmentBlock from '../../components/proposals/InvestmentBlock.astro';
import RiskReduction from '../../components/proposals/RiskReduction.astro';
import ClarityBlock from '../../components/proposals/ClarityBlock.astro';
import ProposalFAQ from '../../components/proposals/ProposalFAQ.astro';
import ProposalCTA from '../../components/proposals/ProposalCTA.astro';
import ProposalFooter from '../../components/proposals/ProposalFooter.astro';
import type { ProposalPage } from '../../data/proposals/types';

export function getStaticPaths() {
  const modules = import.meta.glob<ProposalPage>(['../../data/proposals/*.ts', '!../../data/proposals/types.ts'], {
    eager: true,
    import: 'default',
  });
  const proposals = Object.values(modules);

  return proposals.map((proposal) => ({
    params: { slug: proposal.slug },
    props: { proposal },
  }));
}

const { proposal } = Astro.props;
---

<BaseLayout
  title={proposal.meta.title}
  description={proposal.meta.description}
  robots={proposal.meta.robots}
  ogTitle={proposal.meta.ogTitle}
  ogDescription={proposal.meta.ogDescription}
  ogImage={proposal.meta.ogImage}
  schema={{ '@context': 'https://schema.org', '@type': 'WebPage', name: proposal.meta.ogTitle }}
>
  <ProposalHeader leadName={proposal.lead.name} />
  <main class="bg-gelo">
    <ProposalHero {...proposal.hero} />
    <StartingPoint {...proposal.startingPoint} />
    <StructurePreview {...proposal.structurePreview} />
    <PresenceJourney
      recommendation={proposal.recommendation}
      journey={proposal.journey}
      patientJourney={proposal.patientJourney}
      presenceMap={proposal.presenceMap}
    />
    <RecommendationReason {...proposal.recommendationReason} />
    <ClientResponsibilities {...proposal.clientResponsibilities} />
    <DeliveryProcess process={proposal.process} />
    <RiskReduction {...proposal.riskReduction} />
    <MonthlyResponsibility {...proposal.monthlyResponsibility} />
    {proposal.googleBusinessCare.enabled && <GoogleBusinessCare {...proposal.googleBusinessCare} />}
    <InvestmentBlock investment={proposal.investment} />
    <ClarityBlock {...proposal.clarity} />
    <ProposalFAQ {...proposal.faq} />
    <ProposalCTA {...proposal.cta} />
  </main>
  <ProposalFooter
    leadName={proposal.lead.name}
    proposalDate={proposal.proposalDate}
    tagline={proposal.footer.tagline}
    preparedForLabel={proposal.footer.preparedForLabel}
    contractNote={proposal.footer.contractNote}
  />

  <script>
    if (Array.isArray(window.dataLayer)) {
      window.dataLayer.push({
        event: 'proposal_view',
        proposal_type: 'local_presence_professional',
      });
    }

    document.querySelectorAll('[data-proposal-cta]').forEach((element) => {
      element.addEventListener('click', () => {
        const action = element.getAttribute('data-proposal-cta') === 'secondary'
          ? 'proposal_secondary_cta_click'
          : 'proposal_primary_cta_click';

        if (Array.isArray(window.dataLayer)) {
          window.dataLayer.push({
            event: action,
            proposal_type: 'local_presence_professional',
          });
        }
      });
    });
  </script>
</BaseLayout>
