---
import NichoLayout from '../../layouts/NichoLayout.astro';
import NichoHero from '../../components/sections/NichoHero.astro';
import NichoChecklist from '../../components/sections/NichoChecklist.astro';
import NichoCTA from '../../components/sections/NichoCTA.astro';

const mensagemWpp = 'Olá! Trabalho com estética/beleza e gostaria de saber como a Marvin Sites pode melhorar minha presença digital.';

const itens = [
  'Apresentação dos serviços com fotos reais quando disponíveis',
  'Antes e depois apenas quando permitido e autorizado',
  'Profissional e formações em destaque',
  'Listagem de tratamentos com descrição e público-alvo',
  'Agendamento direto pelo WhatsApp por serviço',
  'Depoimentos autorizados quando disponíveis',
  'Localização e horários de atendimento',
  'Galeria de fotos autorizadas do trabalho',
  'SEO local para "esteticista em [cidade]"',
  'Link para Instagram integrado',
];
---

<NichoLayout
  title="Site para Esteticistas e Salões de Beleza | Marvin Sites"
  description="Estética e beleza dependem de confiança visual. Uma página profissional para esteticistas e salões organiza serviços, fotos, localização e WhatsApp."
  nicho="estetica"
  nomeNicho="Estética e Beleza"
>
  <NichoHero
    nicho="estetica"
    badge="Estética e beleza"
    headline="Fotos, serviços e confiança precisam estar fáceis de encontrar."
    subheadline="No setor de beleza, a decisão começa pela impressão visual e pela clareza. Uma página própria organiza serviços, fotos autorizadas, localização e WhatsApp sem substituir o Instagram."
    argumentoCentral="Seu cliente precisa ver para confiar antes de agendar."
    mensagemWpp={mensagemWpp}
    cor="bg-pink-50 text-pink-700"
  />

  <NichoChecklist itens={itens} titulo="O que sua página de estética vai ter" />

  <section class="bg-gelo py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-petroleo mb-8 text-center">
        Por que profissionais de estética precisam de site próprio?
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { titulo: 'Instagram como complemento', texto: 'Instagram mostra movimento, mas nem sempre organiza serviços, preços, localização e contato num único lugar. A página cria esse ponto estável de consulta.' },
          { titulo: 'Prova visual com cuidado', texto: 'Fotos, portfólio e antes/depois podem ajudar quando forem permitidos, verdadeiros e autorizados. A página dá contexto para esse material sem prometer agendamentos.' },
          { titulo: 'Cuidado dentro do plano', texto: 'Atualizações de serviço, preço ou foto entram conforme os limites do plano contratado. Mudanças maiores são combinadas antes.' },
        ].map((card) => (
          <div class="bg-white rounded-xl border border-nevoa p-6">
            <h3 class="font-semibold text-petroleo mb-2">{card.titulo}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{card.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <NichoCTA nicho="estetica" nomeNicho="clínica de estética" mensagemWpp={mensagemWpp} />
</NichoLayout>
