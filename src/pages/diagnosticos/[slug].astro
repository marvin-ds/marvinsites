---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiagnosticHeader from '../../components/diagnostics/DiagnosticHeader.astro';
import DiagnosticHero from '../../components/diagnostics/DiagnosticHero.astro';
import DiagnosticSummary from '../../components/diagnostics/DiagnosticSummary.astro';
import JourneyStatus from '../../components/diagnostics/JourneyStatus.astro';
import DiscoveryPaths from '../../components/diagnostics/DiscoveryPaths.astro';
import EvidenceGallery from '../../components/diagnostics/EvidenceGallery.astro';
import EvidenceLightbox from '../../components/diagnostics/EvidenceLightbox.astro';
import RecommendationBlock from '../../components/diagnostics/RecommendationBlock.astro';
import DiagnosticCTA from '../../components/diagnostics/DiagnosticCTA.astro';
import DiagnosticFooter from '../../components/diagnostics/DiagnosticFooter.astro';
import { diagnostics } from '../../data/diagnostics/gilvan-salvadori-ferro';
import type { DiagnosticEvidence } from '../../data/diagnostics/gilvan-salvadori-ferro';
import { gerarLinkWhatsApp, WHATSAPP_NUMERO } from '../../lib/whatsapp';

export function getStaticPaths() {
  return Object.values(diagnostics).map((diagnostic) => ({
    params: { slug: diagnostic.slug },
    props: { diagnostic },
  }));
}

const { diagnostic } = Astro.props;
const evidenceById = new Map<string, DiagnosticEvidence>(
  diagnostic.evidence.map((item: DiagnosticEvidence) => [item.id, item]),
);
const getEvidence = (ids: string[]): DiagnosticEvidence[] =>
  ids
    .map((id) => evidenceById.get(id))
    .filter((item): item is DiagnosticEvidence => Boolean(item));
const ctaHref = gerarLinkWhatsApp({
  numero: WHATSAPP_NUMERO,
  mensagem: diagnostic.cta.message,
  origem: 'diagnostico-individual',
  nicho: 'odontologia-santos',
});
---

<BaseLayout
  title={diagnostic.meta.title}
  description={diagnostic.meta.description}
  robots={diagnostic.meta.robots}
  ogTitle={diagnostic.meta.ogTitle}
  ogDescription={diagnostic.meta.ogDescription}
  ogImage={diagnostic.meta.ogImage}
  schema={{ '@context': 'https://schema.org', '@type': 'WebPage', name: diagnostic.meta.ogTitle }}
>
  <DiagnosticHeader leadName={diagnostic.lead.name} />
  <main class="bg-gelo">
    <DiagnosticHero {...diagnostic.hero} />
    <DiagnosticSummary title={diagnostic.summary.title} body={diagnostic.summary.body} />

    <JourneyStatus items={diagnostic.journey} />

    <section class="bg-white px-4 py-14 sm:px-6 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-bold text-petroleo sm:text-4xl">O que você já construiu muito bem</h2>
        </div>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {diagnostic.strengths.map((strength) => (
            <li class="flex min-h-16 items-center gap-3 rounded-2xl border border-nevoa bg-gelo p-4 text-sm font-medium text-petroleo">
              <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-resultado/10 text-resultado" aria-hidden="true">✓</span>
              <span>{strength}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <DiscoveryPaths known={diagnostic.discoveryPaths.known} unknown={diagnostic.discoveryPaths.unknown}>
      <div class="mt-8 space-y-4 rounded-2xl border border-nevoa bg-gelo p-5 text-base leading-relaxed text-grafite/75 sm:p-6">
        {diagnostic.searchFinding.body.map((paragraph) => <p>{paragraph}</p>)}
        <p class="text-lg font-semibold leading-snug text-petroleo">
          A oportunidade é representar melhor seus tratamentos também para quem ainda não chegou procurando por "Dr. Gilvan".
        </p>
        <p class="border-t border-nevoa pt-4 text-sm text-grafite/65">{diagnostic.searchFinding.disclaimer}</p>
      </div>
    </DiscoveryPaths>

    <section class="px-4 py-14 sm:px-6 sm:py-20">
      <div class="mx-auto max-w-5xl space-y-12">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">Evidências</p>
        </div>

        {diagnostic.findings.map((finding, index) => {
          const evidence = getEvidence(finding.evidenceIds);
          return (
            <article class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
              <div class="lg:sticky lg:top-24">
                <h3 class="text-2xl font-bold leading-tight text-petroleo">{finding.title}</h3>
                <div class="mt-4 space-y-3 text-base leading-relaxed text-grafite/75">
                  {finding.body.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </div>
              <EvidenceGallery evidence={evidence} priorityFirst={index === 0} />
            </article>
          );
        })}
      </div>
    </section>

    <section class="px-4 py-14 sm:px-6 sm:py-20">
      <div class="mx-auto max-w-5xl rounded-3xl border border-nevoa bg-white p-6 shadow-sm sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">Oportunidade</p>
            <h2 class="mt-3 text-3xl font-bold text-petroleo sm:text-4xl">{diagnostic.opportunity.title}</h2>
          </div>
          <div class="space-y-4 text-base leading-relaxed text-grafite/75">
            {diagnostic.opportunity.body.map((paragraph) => <p>{paragraph}</p>)}
            <p class="rounded-2xl bg-petroleo p-5 text-lg font-semibold leading-snug text-white">{diagnostic.opportunity.highlight}</p>
          </div>
        </div>
      </div>
    </section>

    <RecommendationBlock {...diagnostic.recommendation} />

    <section class="bg-white px-4 py-14 sm:px-6 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">Nova jornada</p>
          <h2 class="mt-3 text-3xl font-bold text-petroleo sm:text-4xl">{diagnostic.nextJourney.title}</h2>
        </div>
        <ol class="mt-8 grid gap-3 md:grid-cols-5">
          {diagnostic.nextJourney.steps.map((step, index) => (
            <li class="rounded-2xl border border-nevoa bg-gelo p-4 text-center">
              <span class="mx-auto flex h-9 w-9 items-center justify-center rounded-full bg-petroleo text-sm font-bold text-white">{index + 1}</span>
              <p class="mt-3 text-sm font-semibold leading-snug text-petroleo">{step}</p>
            </li>
          ))}
        </ol>
        <p class="mt-6 rounded-2xl bg-petroleo/5 p-5 text-base leading-relaxed text-grafite/75">{diagnostic.nextJourney.microcopy}</p>
      </div>
    </section>

    <section class="px-4 py-10 sm:px-6">
      <div class="mx-auto max-w-5xl rounded-2xl border border-nevoa bg-white p-5 text-sm leading-relaxed text-grafite/70">
        {diagnostic.googleNote}
      </div>
    </section>

    <DiagnosticCTA title={diagnostic.cta.title} body={diagnostic.cta.body} label={diagnostic.cta.label} href={ctaHref} />
  </main>
  <EvidenceLightbox />
  <DiagnosticFooter />

  <script>
    if (Array.isArray(window.dataLayer)) {
      window.dataLayer.push({
        event: 'diagnostic_view',
        diagnostic_type: 'manual_local_presence',
      });
    }
  </script>
</BaseLayout>
