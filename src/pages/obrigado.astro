---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { gerarLinkWhatsApp, WHATSAPP_NUMERO } from '../lib/whatsapp';

const whatsappLink = gerarLinkWhatsApp({
  numero: WHATSAPP_NUMERO,
  mensagem: 'Oi! Acabei de solicitar o diagnóstico da minha presença digital e queria adiantar a conversa.',
  origem: 'obrigado',
});
---

<BaseLayout
  title="Solicitação recebida — Marvin Sites"
  description="Recebemos sua solicitação de diagnóstico. Entraremos em contato pelo WhatsApp em até 24 horas úteis."
  noindex={true}
>
  <Header />

  <main class="min-h-[70vh] flex items-center justify-center px-4 sm:px-6 py-20">
    <div class="max-w-lg w-full text-center">

      <!-- Ícone de confirmação -->
      <div class="flex items-center justify-center w-16 h-16 rounded-full bg-green-100 mx-auto mb-6" aria-hidden="true">
        <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <!-- Eyebrow -->
      <p class="text-sm font-semibold uppercase tracking-widest text-conversao mb-3">
        Diagnóstico recebido
      </p>

      <!-- Headline -->
      <h1 class="text-3xl sm:text-4xl font-bold text-petroleo mb-4 leading-tight">
        Recebemos sua solicitação.
      </h1>

      <!-- Corpo -->
      <p class="text-gray-600 text-base sm:text-lg leading-relaxed mb-8">
        Vamos analisar a presença digital do seu negócio e entrar em contato
        pelo WhatsApp em até 24 horas úteis.
        Você não precisa fazer mais nada agora.
      </p>

      <!-- Lista de confirmações -->
      <ul class="text-left inline-flex flex-col gap-3 mb-10" role="list">
        {[
          'Solicitação recebida',
          'Análise em até 24 horas úteis',
          'Contato pelo WhatsApp informado',
          'Sem compromisso de contratação',
        ].map(item => (
          <li class="flex items-center gap-3 text-gray-700 text-sm sm:text-base">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-green-100 flex items-center justify-center" aria-hidden="true">
              <svg class="w-3 h-3 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>

      <!-- CTA WhatsApp -->
      <div>
        <p class="text-sm text-gray-500 mb-3">
          Se quiser adiantar a conversa, fale diretamente com a Marvin.
        </p>
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          data-wpp-placement="footer"
          class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.117 1.528 5.849L.057 23.998l6.306-1.653A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.792 9.792 0 01-4.992-1.365l-.358-.213-3.712.973.99-3.619-.234-.372A9.796 9.796 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
          </svg>
          Prefiro falar pelo WhatsApp
        </a>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>
