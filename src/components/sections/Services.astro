---
import Button from '../ui/Button.astro';
import { gerarLinkWhatsApp, WHATSAPP_NUMERO } from '../../lib/whatsapp';

const planos = [
  {
    nome: 'Presença Local',
    descricao: 'Para MEIs, autônomos e prestadores que precisam de uma presença rápida, clara e profissional.',
    setup: 'R$ 399',
    mensalidade: 'R$ 97/mês',
    itens: [
      'Página única completa',
      'Serviços e diferenciais apresentados com clareza',
      'Botão de WhatsApp em destaque',
      'Localização, horário e mapa',
      'Fotos do negócio (enviadas por você)',
      'SEO básico local',
      'Revisão do Perfil da Empresa no Google',
      'Domínio configurado no seu nome',
      'Hospedagem e SSL incluídos',
      'Uma rodada de revisão',
      'Manutenção mensal inclusa',
    ],
    destaque: false,
    mensagem: 'Olá! Tenho interesse no plano Presença Local (R$399 + R$97/mês). Pode me dar mais informações?',
  },
  {
    nome: 'Site Profissional',
    descricao: 'Para clínicas, escritórios, consultorias e empresas que precisam de mais autoridade e estrutura.',
    setup: 'R$ 599',
    mensalidade: 'R$ 197/mês',
    itens: [
      'Tudo do plano Presença Local',
      'Site com 4 a 6 páginas',
      'Página inicial + Sobre + Serviços + Contato',
      'Copy comercial mais aprofundado',
      'SEO local inicial mais amplo',
      'Otimização mais completa do Perfil da Empresa',
      'Duas rodadas de revisão',
      'Manutenção mensal inclusa',
    ],
    destaque: true,
    mensagem: 'Olá! Tenho interesse no plano Site Profissional (R$599 + R$197/mês). Pode me dar mais informações?',
  },
];
---

<section id="servicos" class="bg-white py-20 px-4 sm:px-6">
  <div class="max-w-5xl mx-auto">

    <div class="text-center mb-12">
      <span class="text-xs font-medium text-orange-700 uppercase tracking-widest">Planos</span>
      <h2 class="text-3xl sm:text-4xl font-bold text-petroleo mt-3 leading-tight">
        Comece com o que faz sentido agora
      </h2>
      <p class="text-gray-500 mt-4 max-w-xl mx-auto">
        Sem contrato longo — mínimo de 3 meses, depois mês a mês.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
      {planos.map((plano) => (
        <div class={`rounded-2xl border p-7 flex flex-col ${plano.destaque ? 'border-confianca bg-petroleo text-white shadow-xl' : 'border-nevoa bg-gelo'}`}>

          {plano.destaque && (
            <span class="inline-flex self-start bg-confianca text-white text-xs font-medium px-3 py-1 rounded-full mb-4">
              Mais completo
            </span>
          )}

          <h3 class={`text-lg font-bold mb-2 ${plano.destaque ? 'text-white' : 'text-petroleo'}`}>
            {plano.nome}
          </h3>
          <p class={`text-sm leading-relaxed mb-6 ${plano.destaque ? 'text-white/60' : 'text-gray-500'}`}>
            {plano.descricao}
          </p>

          <div class="mb-6">
            <div class={`text-3xl font-bold ${plano.destaque ? 'text-white' : 'text-petroleo'}`}>{plano.setup}</div>
            <div class={`text-sm mt-1 ${plano.destaque ? 'text-white/70' : 'text-gray-600'}`}>
              implantação única + {plano.mensalidade} cuidado contínuo
            </div>
          </div>

          <ul class="space-y-2.5 mb-8 flex-1">
            {plano.itens.map((item) => (
              <li class={`flex items-start gap-2.5 text-sm ${plano.destaque ? 'text-white/80' : 'text-grafite'}`}>
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-resultado" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>

          <Button
            href={gerarLinkWhatsApp({ numero: WHATSAPP_NUMERO, mensagem: plano.mensagem, origem: 'card-servico', nicho: plano.nome })}
            variant={plano.destaque ? 'primary' : 'ghost'}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full justify-center"
            wppPlacement="plans"
          >
            Quero este plano
          </Button>

        </div>
      ))}
    </div>

    <p class="text-center text-sm text-gray-600 mt-8 max-w-xl mx-auto">
      Precisa de algo maior — páginas por cidade, SEO avançado ou crescimento local contínuo?
      <a
        href={gerarLinkWhatsApp({ numero: WHATSAPP_NUMERO, mensagem: 'Olá! Preciso de algo mais completo para meu negócio. Pode me apresentar uma proposta?', origem: 'servicos-rodape' })}
        target="_blank"
        rel="noopener noreferrer"
        class="text-confianca underline ml-1"
        data-wpp-placement="plans"
      >
        Fale pelo WhatsApp — apresentamos uma proposta.
      </a>
    </p>

  </div>
</section>
