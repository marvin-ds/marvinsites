---
import Button from '../ui/Button.astro';
import { gerarLinkWhatsApp, WHATSAPP_NUMERO } from '../../lib/whatsapp';

const solucoes = [
  {
    nome: 'Presença Essencial',
    descricao: 'Para organizar o básico com clareza: serviços, localização, prova, Google e caminho para o WhatsApp.',
    itens: [
      'Presença própria adequada ao negócio',
      'Serviços e diferenciais explicados com clareza',
      'Contato e WhatsApp em destaque',
      'Informações locais consistentes',
      'Base inicial para busca local',
    ],
    cta: 'Ver se faz sentido',
  },
  {
    nome: 'Presença Profissional',
    descricao: 'Para negócios que precisam apresentar melhor serviços, equipe, especialidades, autoridade e estrutura.',
    itens: [
      'Estrutura mais completa de conteúdo',
      'Mais espaço para prova e diferenciais',
      'Organização por serviços ou áreas de atuação',
      'Preview antes da publicação',
      'Cuidado contínuo da presença',
    ],
    cta: 'Quero uma recomendação',
  },
  {
    nome: 'Crescimento Local',
    descricao: 'Para operações que já têm mais maturidade e precisam evoluir páginas, campanhas, tracking ou novas oportunidades digitais.',
    itens: [
      'Páginas por serviço, região ou campanha',
      'Tracking e mensuração quando aplicável',
      'Acompanhamento e melhorias contínuas',
      'Escopo personalizado',
      'Evolução sem mudança silenciosa de valor',
    ],
    cta: 'Falar sobre meu cenário',
  },
];

const familias = [
  'Saúde, Estética e Bem-estar',
  'Clínicas e Consultórios',
  'Contabilidade, Consultorias e B2B',
  'Construção, Reformas e Manutenção',
  'Turismo e Hospedagem',
  'Imobiliário',
  'Educação e Cursos',
  'Alimentação',
  'Serviços Locais Especializados',
];
---

<section id="servicos" class="bg-white py-20 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto space-y-16">

    <div>
      <div class="text-center mb-12">
        <span class="text-xs font-medium text-orange-700 uppercase tracking-widest">Soluções</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-petroleo mt-3 leading-tight">
          Uma presença adequada ao momento do seu negócio
        </h2>
        <p class="text-gray-500 mt-4 max-w-2xl mx-auto leading-relaxed">
          Você não precisa escolher plano antes de entender o cenário. O diagnóstico ajuda a indicar uma estrutura suficiente, sem complexidade desnecessária.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {solucoes.map((solucao, index) => (
          <article class={`rounded-2xl border p-7 flex flex-col ${index === 1 ? 'border-confianca bg-petroleo text-white shadow-xl' : 'border-nevoa bg-gelo'}`}>
            <h3 class={`text-xl font-bold mb-3 ${index === 1 ? 'text-white' : 'text-petroleo'}`}>
              {solucao.nome}
            </h3>
            <p class={`text-sm leading-relaxed mb-6 ${index === 1 ? 'text-white/70' : 'text-gray-500'}`}>
              {solucao.descricao}
            </p>

            <ul class="space-y-3 mb-8 flex-1">
              {solucao.itens.map((item) => (
                <li class={`flex items-start gap-2.5 text-sm ${index === 1 ? 'text-white/80' : 'text-grafite'}`}>
                  <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-resultado" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>

            <Button href="#contato" variant={index === 1 ? 'primary' : 'ghost'} class="w-full justify-center">
              {solucao.cta}
            </Button>
          </article>
        ))}
      </div>

      <p class="text-center text-sm text-gray-600 mt-8 max-w-2xl mx-auto">
        Também existe uma estrutura de entrada para operações simples quando o diagnóstico mostrar que ela é suficiente.
        Condições, escopo, limites e valor são apresentados antes da contratação.
      </p>
    </div>

    <div class="bg-gelo rounded-2xl border border-nevoa p-8 sm:p-10">
      <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-8 items-start">
        <div>
          <span class="text-xs font-medium text-confianca uppercase tracking-widest">Para quem é</span>
          <h2 class="text-3xl font-bold text-petroleo mt-3 leading-tight">
            Atendemos diferentes tipos de negócio local.
          </h2>
          <p class="text-gray-500 mt-4 leading-relaxed">
            Nem toda família abaixo tem um modelo publicado ainda. Quando não houver referência pronta, avaliamos o cenário e estruturamos a presença adequada.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {familias.map((familia) => (
            <div class="bg-white rounded-xl border border-nevoa p-4 text-sm font-medium text-petroleo">
              {familia}
            </div>
          ))}
        </div>
      </div>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <Button href="#exemplos" variant="secondary">
          Ver exemplos publicados
        </Button>
        <Button
          href={gerarLinkWhatsApp({ numero: WHATSAPP_NUMERO, mensagem: 'Olá! Meu segmento não está nos exemplos. Quero avaliar minha presença digital com a Marvin.', origem: 'segmento-nao-listado' })}
          variant="ghost"
          target="_blank"
          rel="noopener noreferrer"
          wppPlacement="plans"
        >
          Meu segmento não está aqui
        </Button>
      </div>
    </div>

  </div>
</section>
