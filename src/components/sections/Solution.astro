---
import Button from '../ui/Button.astro';

const passos = [
  {
    numero: '01',
    titulo: 'Diagnóstico da presença atual',
    descricao: 'Olhamos Google, site quando existir, serviços, localização, prova, informações e caminho até o contato.',
  },
  {
    numero: '02',
    titulo: 'Recomendação clara',
    descricao: 'Mostramos o que já está funcionando, onde existe oportunidade e qual estrutura faz sentido, sem propor algo maior apenas para aumentar o projeto.',
  },
  {
    numero: '03',
    titulo: 'Produção e Preview',
    descricao: 'Se você decidir seguir, organizamos conteúdo, estrutura e presença e apresentamos uma primeira versão para sua revisão.',
  },
  {
    numero: '04',
    titulo: 'Sua aprovação',
    descricao: 'Você vê o resultado antes da publicação e solicita os ajustes previstos no escopo.',
  },
  {
    numero: '05',
    titulo: 'Publicação e cuidado contínuo',
    descricao: 'Depois de aprovada, publicamos e seguimos cuidando da presença dentro do plano contratado.',
  },
];

---

<section id="como-funciona" class="bg-gelo py-20 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto space-y-14">

    <div class="bg-petroleo rounded-2xl p-8 sm:p-10 text-white grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-8 items-center">
      <div>
        <h2 class="text-3xl font-bold leading-tight">
          Primeiro, entendemos o que você já tem.
        </h2>
        <div class="text-white/75 mt-5 leading-relaxed space-y-3">
          <p>Você pode não precisar começar do zero.</p>
          <p>A Marvin analisa como seu negócio aparece hoje, identifica o que já funciona e mostra onde existe espaço para melhorar.</p>
          <p>Só então recomendamos o próximo passo que faça sentido.</p>
        </div>
      </div>
      <div class="flex flex-col gap-3">
        <Button href="#contato" variant="primary" size="lg" class="whitespace-nowrap">
          Quero meu diagnóstico
        </Button>
        <p class="text-sm text-white/70 text-center">Sem compromisso de contratação</p>
      </div>
    </div>

    <div>
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-petroleo leading-tight">
          Como funciona
        </h2>
        <p class="text-gray-500 mt-4 max-w-2xl mx-auto leading-relaxed">
          Você entende o cenário, recebe uma recomendação clara e só avança se fizer sentido.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
        {passos.map((passo) => (
          <article class="bg-white rounded-2xl p-6 border border-nevoa">
            <span class="text-4xl font-bold text-gray-200" aria-hidden="true">{passo.numero}</span>
            <h3 class="text-base font-semibold text-petroleo mt-3 mb-2">{passo.titulo}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{passo.descricao}</p>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>
