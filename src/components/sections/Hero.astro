---
import Button from '../ui/Button.astro';
---

<section class="bg-gelo pt-16 pb-20 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

    <!-- Copy -->
    <div>
      <span class="inline-flex items-center gap-2 bg-blue-50 text-confianca text-xs font-medium px-3 py-1 rounded-full mb-6">
        <span class="w-1.5 h-1.5 bg-confianca rounded-full"></span>
        Presença digital para pequenos negócios
      </span>

      <h1 class="text-4xl sm:text-5xl font-bold text-petroleo leading-tight tracking-tight mb-5">
        Quando alguém pesquisa sua empresa, o que encontra?
      </h1>

      <p class="text-lg text-gray-500 leading-relaxed mb-8 max-w-lg">
        A Marvin organiza site, Google e WhatsApp para o cliente encontrar, entender e confiar no seu negócio — e chamar você com facilidade.
      </p>

      <div class="flex flex-col sm:flex-row gap-3">
        <Button href="#contato" variant="primary" size="lg" wppPlacement="hero">
          Quero meu diagnóstico gratuito
        </Button>
        <Button href="#exemplos" variant="ghost" size="lg">
          Ver exemplos
        </Button>
      </div>

      <!-- Trust signals -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-8 text-sm text-gray-600">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-resultado" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Entrega em 7 dias úteis
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-resultado" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Sem contrato longo
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-resultado" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Domínio no seu nome
        </span>
      </div>
    </div>

    <!-- Visual — fluxo Google → Site → WhatsApp -->
    <div class="relative flex justify-center lg:justify-end">
      <div class="w-full max-w-sm">

        <!-- Fluxo visual -->
        <div class="space-y-3">

          <!-- Google -->
          <div class="bg-white rounded-xl border border-nevoa px-5 py-4 flex items-center gap-4 shadow-sm">
            <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
            </div>
            <div>
              <div class="text-xs text-gray-400 leading-none mb-0.5">Google</div>
              <div class="text-sm font-medium text-petroleo">Sua empresa aparece na busca</div>
            </div>
          </div>

          <div class="flex justify-center">
            <svg class="w-4 h-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>

          <!-- Perfil da Empresa -->
          <div class="bg-white rounded-xl border border-nevoa px-5 py-4 flex items-center gap-4 shadow-sm">
            <div class="w-9 h-9 rounded-lg bg-orange-50 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-conversao" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <div class="text-xs text-gray-400 leading-none mb-0.5">Perfil da Empresa no Google</div>
              <div class="text-sm font-medium text-petroleo">Informações claras e avaliações</div>
            </div>
          </div>

          <div class="flex justify-center">
            <svg class="w-4 h-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>

          <!-- Página / Site -->
          <div class="bg-white rounded-xl border border-nevoa px-5 py-4 flex items-center gap-4 shadow-sm">
            <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-confianca" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs text-gray-400 leading-none mb-0.5">Página / Site</div>
              <div class="text-sm font-medium text-petroleo">Serviços, fotos e diferenciais</div>
            </div>
          </div>

          <div class="flex justify-center">
            <svg class="w-4 h-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>

          <!-- WhatsApp -->
          <div class="bg-green-50 rounded-xl border border-green-200 px-5 py-4 flex items-center gap-4 shadow-sm">
            <div class="w-9 h-9 rounded-lg bg-green-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-resultado" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.117 1.528 5.849L.057 23.998l6.306-1.653A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.792 9.792 0 01-4.992-1.365l-.358-.213-3.712.973.99-3.619-.234-.372A9.796 9.796 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs text-green-600 leading-none mb-0.5">WhatsApp</div>
              <div class="text-sm font-medium text-petroleo">O cliente chama com facilidade</div>
            </div>
          </div>

        </div>

        <!-- Legenda âncora -->
        <p class="text-center text-xs text-gray-400 mt-4 tracking-wide">
          encontrar · entender · confiar · chamar
        </p>

      </div>

      <!-- Glow decorativo -->
      <div class="absolute inset-0 bg-confianca/5 rounded-full blur-3xl -z-10"></div>
    </div>

  </div>
</section>
