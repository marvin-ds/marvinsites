<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-nevoa">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5" aria-label="Marvin Sites — página inicial">
      <img src="/favicon.svg" alt="" class="h-9 w-9" width="36" height="36" aria-hidden="true" />
      <span class="text-lg font-semibold text-petroleo tracking-tight">
        Marvin <span class="text-confianca">Sites</span>
      </span>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-grafite">
      <a href="/#como-funciona" class="hover:text-petroleo transition-colors">Como funciona</a>
      <a href="/#exemplos"  class="hover:text-petroleo transition-colors">Exemplos</a>
      <a href="/#servicos"  class="hover:text-petroleo transition-colors">Para quem é</a>
      <a href="/#faq"       class="hover:text-petroleo transition-colors">Dúvidas</a>
    </nav>

    <!-- CTA principal -->
    <a
      href="/#contato"
      class="flex items-center gap-2 bg-conversao text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-orange-600 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6M7 4h10a2 2 0 012 2v12a2 2 0 01-2 2H7a2 2 0 01-2-2V6a2 2 0 012-2z"/>
      </svg>
      Diagnóstico gratuito
    </a>

  </div>
