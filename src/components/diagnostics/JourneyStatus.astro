---
import type { DiagnosticJourneyItem } from '../../data/diagnostics/gilvan-salvadori-ferro';

interface Props {
  items: DiagnosticJourneyItem[];
}

const { items } = Astro.props;

const statusClasses = {
  strong: 'border-resultado/30 bg-resultado/10 text-resultado',
  good: 'border-confianca/25 bg-confianca/10 text-confianca',
  opportunity: 'border-conversao/30 bg-conversao/10 text-conversao',
  attention: 'border-amber-400/35 bg-amber-50 text-amber-700',
};
---

<section class="px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">Jornada Marvin</p>
      <h2 class="mt-3 text-3xl font-bold text-petroleo sm:text-4xl">Encontrar, entender, confiar e chamar.</h2>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {items.map((item, index) => (
        <article class="rounded-2xl border border-nevoa bg-white p-5 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-petroleo text-sm font-bold text-white">{index + 1}</span>
            <span class={`rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] ${statusClasses[item.status]}`}>
              {item.label}
            </span>
          </div>
          <h3 class="mt-5 text-xl font-semibold text-petroleo">{item.headline}</h3>
          <p class="mt-3 text-sm leading-relaxed text-grafite/75">{item.summary}</p>
          {item.opportunity && <p class="mt-4 rounded-xl bg-gelo p-4 text-sm leading-relaxed text-grafite/75">{item.opportunity}</p>}
        </article>
      ))}
    </div>
  </div>
</section>
