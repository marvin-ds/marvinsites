---
---

<div
  id="consent-prefs-overlay"
  class="fixed inset-0 z-[300] bg-black/60 hidden flex items-end sm:items-center justify-center p-4"
  aria-hidden="true"
>
  <div
    id="consent-prefs-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="consent-prefs-title"
    class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto"
    tabindex="-1"
  >
    <!-- Header -->
    <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-gray-100">
      <h2 id="consent-prefs-title" class="text-[#0B1F33] font-semibold text-lg">
        Preferências de privacidade
      </h2>
      <button
        id="consent-prefs-close"
        aria-label="Fechar preferências"
        class="text-gray-400 hover:text-gray-600 transition-colors p-1 rounded"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="px-6 py-5 space-y-5">

      <!-- Necessários (always on) -->
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1">
          <p class="font-medium text-[#111827] text-sm">Essenciais</p>
          <p class="text-gray-500 text-xs mt-1">Necessários para o funcionamento do site. Não podem ser desativados.</p>
        </div>
        <div class="flex-shrink-0">
          <span class="text-xs text-gray-400 font-medium">Sempre ativo</span>
        </div>
      </div>

      <hr class="border-gray-100" />

      <!-- Analytics -->
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1">
          <label for="pref-analytics" class="font-medium text-[#111827] text-sm cursor-pointer">
            Medição e estatísticas
          </label>
          <p class="text-gray-500 text-xs mt-1">
            Nos ajuda a entender como os visitantes usam o site para melhorar a experiência. Nenhum dado pessoal é coletado.
          </p>
        </div>
        <div class="flex-shrink-0 mt-0.5">
          <button
            id="pref-analytics"
            role="switch"
            aria-checked="false"
            aria-label="Ativar medição e estatísticas"
            class="consent-toggle w-11 h-6 rounded-full transition-colors bg-gray-200 relative focus:outline-none focus:ring-2 focus:ring-[#2563EB] focus:ring-offset-2"
          >
            <span class="toggle-thumb block w-4 h-4 rounded-full bg-white shadow absolute top-1 left-1 transition-transform"></span>
          </button>
        </div>
      </div>

      <hr class="border-gray-100" />

      <!-- Ad measurement -->
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1">
          <label for="pref-ads" class="font-medium text-[#111827] text-sm cursor-pointer">
            Medição de publicidade
          </label>
          <p class="text-gray-500 text-xs mt-1">
            Permite medir o desempenho dos anúncios que mostramos. Sem isso, não conseguimos saber quais anúncios levaram você ao nosso site.
          </p>
        </div>
        <div class="flex-shrink-0 mt-0.5">
          <button
            id="pref-ads"
            role="switch"
            aria-checked="false"
            aria-label="Ativar medição de publicidade"
            class="consent-toggle w-11 h-6 rounded-full transition-colors bg-gray-200 relative focus:outline-none focus:ring-2 focus:ring-[#2563EB] focus:ring-offset-2"
          >
            <span class="toggle-thumb block w-4 h-4 rounded-full bg-white shadow absolute top-1 left-1 transition-transform"></span>
          </button>
        </div>
      </div>

      <hr class="border-gray-100" />

      <!-- Ad personalization -->
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1">
          <label for="pref-personalization" class="font-medium text-[#111827] text-sm cursor-pointer">
            Publicidade personalizada
          </label>
          <p class="text-gray-500 text-xs mt-1">
            Permite exibir anúncios mais relevantes com base nos seus interesses. Requer medição de publicidade ativa.
          </p>
        </div>
        <div class="flex-shrink-0 mt-0.5">
          <button
            id="pref-personalization"
            role="switch"
            aria-checked="false"
            aria-label="Ativar publicidade personalizada"
            class="consent-toggle w-11 h-6 rounded-full transition-colors bg-gray-200 relative focus:outline-none focus:ring-2 focus:ring-[#2563EB] focus:ring-offset-2"
            disabled
          >
            <span class="toggle-thumb block w-4 h-4 rounded-full bg-white shadow absolute top-1 left-1 transition-transform"></span>
          </button>
        </div>
      </div>

    </div>

    <!-- Footer -->
    <div class="px-6 pb-6 pt-2 flex flex-col sm:flex-row gap-3">
      <button
        id="consent-prefs-save"
        class="flex-1 bg-[#FF6B2C] text-white text-sm font-semibold px-5 py-3 rounded-lg hover:bg-orange-600 transition-colors min-h-[44px]"
      >
        Salvar preferências
      </button>
      <button
        id="consent-prefs-reject-all"
        class="flex-1 bg-gray-100 text-gray-700 text-sm font-medium px-5 py-3 rounded-lg hover:bg-gray-200 transition-colors min-h-[44px]"
      >
        Recusar não essenciais
      </button>
    </div>
  </div>
</div>

<style>
  .consent-toggle[aria-checked="true"] {
    background-color: #2563EB;
  }
  .consent-toggle[aria-checked="true"] .toggle-thumb {
    transform: translateX(20px);
  }
  .consent-toggle:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
</style>

<script>
  import {
    readStoredConsent,
    saveConsent,
    buildRejectAll,
    applyDependencies,
    isGtmEligible,
    CONSENT_VERSION,
  } from '../../lib/consent';
  import type { ConsentState, ConsentValue } from '../../lib/consent';
  import { isValidGtmId, loadGtm } from '../../lib/gtm';

  const overlay = document.getElementById('consent-prefs-overlay')!;
  const modal = document.getElementById('consent-prefs-modal')!;
  const btnClose = document.getElementById('consent-prefs-close')!;
  const btnSave = document.getElementById('consent-prefs-save')!;
  const btnRejectAll = document.getElementById('consent-prefs-reject-all')!;
  const toggleAnalytics = document.getElementById('pref-analytics') as HTMLButtonElement;
  const toggleAds = document.getElementById('pref-ads') as HTMLButtonElement;
  const togglePersonal = document.getElementById('pref-personalization') as HTMLButtonElement;

  let openerElement: HTMLElement | null = null;

  function pushDL(obj: Record<string, unknown>) {
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push(obj);
  }

  function setToggle(btn: HTMLButtonElement, value: boolean) {
    btn.setAttribute('aria-checked', value ? 'true' : 'false');
  }

  function getToggle(btn: HTMLButtonElement): ConsentValue {
    return btn.getAttribute('aria-checked') === 'true' ? 'granted' : 'denied';
  }

  function syncPersonalizationDisabled() {
    const adsOn = toggleAds.getAttribute('aria-checked') === 'true';
    if (!adsOn) {
      setToggle(togglePersonal, false);
      togglePersonal.disabled = true;
    } else {
      togglePersonal.disabled = false;
    }
  }

  function loadCurrentState() {
    const stored = readStoredConsent();
    setToggle(toggleAnalytics, stored?.analytics_storage === 'granted');
    setToggle(toggleAds, stored?.ad_storage === 'granted');
    setToggle(togglePersonal, stored?.ad_personalization === 'granted');
    syncPersonalizationDisabled();
  }

  // Focusable elements inside modal for trap
  function getFocusable(): HTMLElement[] {
    return Array.from(
      modal.querySelectorAll<HTMLElement>(
        'button:not([disabled]), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      )
    );
  }

  function openModal(opener?: HTMLElement) {
    openerElement = opener || null;
    loadCurrentState();
    overlay.classList.remove('hidden');
    overlay.setAttribute('aria-hidden', 'false');
    modal.focus();
  }

  function closeModal() {
    overlay.classList.add('hidden');
    overlay.setAttribute('aria-hidden', 'true');
    openerElement?.focus();
    openerElement = null;
  }

  function applyAndClose(state: ConsentState) {
    saveConsent(state);
    closeModal();
    pushDL(['consent', 'update', {
      analytics_storage: state.analytics_storage,
      ad_storage: state.ad_storage,
      ad_user_data: state.ad_user_data,
      ad_personalization: state.ad_personalization,
    }]);
    pushDL({
      event: 'consent_updated',
      consent_version: state.version,
      analytics_storage: state.analytics_storage,
      ad_storage: state.ad_storage,
      ad_user_data: state.ad_user_data,
      ad_personalization: state.ad_personalization,
    });
    const gtmId = (import.meta as any).env?.PUBLIC_GTM_ID;
    if (isValidGtmId(gtmId) && isGtmEligible(state)) {
      loadGtm(gtmId);
    }
  }

  // Toggle handlers
  [toggleAnalytics, toggleAds, togglePersonal].forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.disabled) return;
      const current = btn.getAttribute('aria-checked') === 'true';
      setToggle(btn, !current);
      syncPersonalizationDisabled();
    });
  });

  // Save
  btnSave.addEventListener('click', () => {
    const state = applyDependencies({
      version: CONSENT_VERSION,
      updatedAt: new Date().toISOString(),
      analytics_storage: getToggle(toggleAnalytics),
      ad_storage: getToggle(toggleAds),
      ad_user_data: getToggle(toggleAds), // ad_user_data mirrors ad_storage
      ad_personalization: getToggle(togglePersonal),
    });
    applyAndClose(state);
  });

  // Reject all
  btnRejectAll.addEventListener('click', () => {
    applyAndClose(buildRejectAll());
  });

  // Close button
  btnClose.addEventListener('click', closeModal);

  // Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Focus trap
  modal.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusable = getFocusable();
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Listen for open event
  document.addEventListener('marvin:open-consent-prefs', (e) => {
    const detail = (e as CustomEvent).detail;
    openModal(detail?.opener);
  });

  // Click outside closes
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });
</script>
