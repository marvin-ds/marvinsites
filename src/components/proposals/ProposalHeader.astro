---
interface Props {
  leadName: string;
}

const { leadName } = Astro.props;
---

<header class="border-b border-white/10 bg-petroleo text-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="flex items-center gap-3 focus-visible:rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-confianca" aria-label="Marvin Sites - página inicial">
      <img src="/diagnosticos/_shared/marvin-logo-square.png" alt="" class="h-10 w-10 rounded-lg object-cover" width="40" height="40" aria-hidden="true" />
      <span class="text-base font-semibold tracking-tight">Marvin <span class="text-confianca">Sites</span></span>
    </a>
    <div class="text-right text-xs leading-snug text-white/70 sm:text-sm">
      <p class="font-medium text-white">
        <span class="sm:hidden">Proposta</span>
        <span class="hidden sm:inline">Proposta de Presença Digital Local</span>
      </p>
      <p class="hidden sm:block">Preparada para {leadName}</p>
    </div>
  </div>
</header>
