---
import type { ProposalPage } from '../../data/proposals/types';

interface Props {
  care: ProposalPage['continuousCare'];
  monthlyReason: ProposalPage['monthlyReason'];
}

const { care, monthlyReason } = Astro.props;
---

<section class="bg-white px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl space-y-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">Cuidado contínuo</p>
      <h2 class="mt-3 text-3xl font-bold leading-tight text-petroleo sm:text-4xl">{care.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-grafite/75">{care.intro}</p>
    </div>

    <div class="rounded-3xl bg-petroleo p-6 text-white shadow-2xl shadow-petroleo/20 sm:p-10">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">{care.highlightTitle}</p>
      <p class="mt-4 max-w-3xl text-2xl font-bold leading-tight sm:text-3xl">{care.highlightBody}</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {care.pillars.map((pillar) => (
        <article class={`rounded-3xl border p-5 shadow-sm ${pillar.title === 'Encontrável' ? 'border-confianca/25 bg-confianca/5' : 'border-nevoa bg-gelo'}`}>
          <h3 class="text-xl font-bold text-petroleo">{pillar.title}</h3>
          {pillar.body && <p class="mt-3 text-sm leading-relaxed text-grafite/72">{pillar.body}</p>}
          <ul class="mt-4 space-y-2 text-sm leading-relaxed text-grafite/70">
            {pillar.items.map((item) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-resultado" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="rounded-3xl border border-nevoa bg-gelo p-6 sm:p-8">
      <h3 class="text-2xl font-bold leading-tight text-petroleo">{monthlyReason.title}</h3>
      <div class="mt-4 space-y-3 text-base leading-relaxed text-grafite/75">
        {monthlyReason.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="mt-5 rounded-2xl bg-white p-5 text-lg font-semibold leading-snug text-petroleo">{monthlyReason.highlight}</p>
    </div>

    <div class="rounded-3xl bg-petroleo p-6 text-white sm:p-10">
      {care.valuePhrase.map((line) => <p class="text-3xl font-bold leading-tight sm:text-4xl">{line}</p>)}
    </div>
  </div>
</section>
