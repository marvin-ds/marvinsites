---
interface Props {
  process: {
    step: number;
    title: string;
    body: string;
  }[];
}

const { process } = Astro.props;
---

<section class="px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">Como funciona</p>
      <h2 class="mt-3 text-3xl font-bold text-petroleo sm:text-4xl">Simples para você. Organizado por trás.</h2>
    </div>

    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {process.map((item) => (
        <li class="rounded-2xl border border-nevoa bg-white p-5 shadow-sm">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-petroleo text-sm font-bold text-white">{item.step}</span>
          <h3 class="mt-4 text-lg font-bold text-petroleo">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-grafite/70">{item.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
