---
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  valueStatement: string;
  items: {
    title: string;
    body: string;
    examples?: string[];
  }[];
  closing: string[];
}

const { eyebrow, title, subtitle, valueStatement, items, closing } = Astro.props;
---

<section class="bg-white px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl">
    <div class="rounded-3xl bg-petroleo p-6 text-white shadow-2xl shadow-petroleo/20 sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">{eyebrow}</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight sm:text-4xl">{title}</h2>
          <p class="mt-4 text-base leading-relaxed text-white/74">{subtitle}</p>
          <p class="mt-5 rounded-2xl border border-white/10 bg-white/[0.08] p-4 text-base font-semibold leading-relaxed text-white">{valueStatement}</p>
        </div>

        <div class="grid gap-3">
          {items.map((item) => (
            <article class="rounded-2xl border border-white/10 bg-white/[0.08] p-5">
              <h3 class="text-lg font-bold text-white">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/74">{item.body}</p>
              {item.examples && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {item.examples.map((example) => (
                    <span class="rounded-full border border-white/10 px-3 py-1 text-xs font-semibold text-white/70">{example}</span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-5 rounded-3xl border border-nevoa bg-gelo p-6 sm:p-8">
      <div class="space-y-3">
        {closing.map((line, index) => (
          <p class={index < 2 ? 'text-3xl font-bold leading-tight text-petroleo sm:text-4xl' : 'text-base leading-relaxed text-grafite/70'}>{line}</p>
        ))}
      </div>
    </div>
  </div>
</section>
