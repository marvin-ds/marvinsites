---
interface Props {
  title: string;
  beforeTitle: string;
  beforeItems: string[];
  afterTitle: string;
  afterItems: string[];
  closing: string;
}

const { title, beforeTitle, beforeItems, afterTitle, afterItems, closing } = Astro.props;
---

<section class="px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl rounded-3xl border border-nevoa bg-gelo p-6 sm:p-10">
    <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
      <div>
        <h2 class="text-3xl font-bold leading-tight text-petroleo sm:text-4xl">{title}</h2>
        <p class="mt-5 rounded-2xl bg-white p-5 text-lg font-semibold leading-snug text-petroleo">{closing}</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <article class="rounded-2xl border border-nevoa bg-white p-5 shadow-sm">
          <h3 class="text-lg font-bold text-petroleo">{beforeTitle}</h3>
          <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-grafite/74">
            {beforeItems.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="rounded-2xl border border-confianca/20 bg-white p-5 shadow-sm">
          <h3 class="text-lg font-bold text-petroleo">{afterTitle}</h3>
          <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-grafite/74">
            {afterItems.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>
