---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  items: {
    title: string;
    type?: 'page' | 'section' | 'area';
    body: string;
  }[];
}

const { eyebrow, title, intro, items } = Astro.props;
const labelByType = {
  page: 'Página',
  section: 'Seção',
  area: 'Área',
};
---

<section class="bg-white px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl">
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">{eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-petroleo sm:text-4xl">{title}</h2>
        <p class="mt-4 text-base leading-relaxed text-grafite/75">{intro}</p>
      </div>

      <div class="rounded-3xl border border-nevoa bg-gelo p-4 sm:p-5">
        <div class="grid gap-3">
          {items.map((item, index) => (
            <article class="rounded-2xl border border-nevoa bg-white p-4 shadow-sm">
              <div class="flex items-start gap-4">
                <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-petroleo text-sm font-bold text-white">{index + 1}</span>
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-base font-bold text-petroleo">{item.title}</h3>
                    {item.type && (
                      <span class="rounded-full bg-confianca/10 px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.1em] text-confianca">{labelByType[item.type]}</span>
                    )}
                  </div>
                  <p class="mt-2 text-sm leading-relaxed text-grafite/72">{item.body}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
