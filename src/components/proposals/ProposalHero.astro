---
import Button from '../ui/Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string[];
  highlight: string[];
  ctaLabel: string;
}

const { eyebrow, title, intro, highlight, ctaLabel } = Astro.props;
---

<section class="relative overflow-hidden bg-petroleo px-4 pb-16 pt-10 text-white sm:px-6 sm:pb-24 sm:pt-16">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-[1fr_0.78fr] lg:items-end">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-conversao">{eyebrow}</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">{title}</h1>
      <div class="mt-6 max-w-2xl space-y-4 text-lg leading-relaxed text-white/78">
        {intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="mt-8">
        <Button href="#proposta" variant="primary" size="lg">{ctaLabel}</Button>
      </div>
    </div>

    <aside class="rounded-3xl border border-white/10 bg-white/[0.08] p-5 shadow-2xl shadow-black/20 backdrop-blur sm:p-6">
      <div class="space-y-4">
        <div class="inline-flex rounded-full border border-white/12 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-white/65">
          Continuação do diagnóstico
        </div>
        <div class="space-y-2">
          {highlight.map((line) => (
            <p class="text-2xl font-bold leading-tight text-white sm:text-3xl">{line}</p>
          ))}
        </div>
        <div class="grid gap-3 pt-2 text-sm text-white/72">
          <div class="rounded-2xl border border-white/10 bg-white/[0.08] p-4">
            <p class="font-semibold text-white">Diagnóstico</p>
            <p class="mt-1">o que encontramos</p>
          </div>
          <div class="rounded-2xl border border-conversao/35 bg-conversao/12 p-4">
            <p class="font-semibold text-white">Proposta</p>
            <p class="mt-1">o que recomendamos fazer, como cuidaremos e quanto custa</p>
          </div>
        </div>
      </div>
    </aside>
  </div>
</section>
