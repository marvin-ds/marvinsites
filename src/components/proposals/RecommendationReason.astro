---
interface Props {
  eyebrow: string;
  title: string;
  body: string[];
  reasons: string[];
  highlight: string;
}

const { eyebrow, title, body, reasons, highlight } = Astro.props;
---

<section class="px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl rounded-3xl border border-confianca/20 bg-white p-6 shadow-sm sm:p-10">
    <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-confianca">{eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-petroleo sm:text-4xl">{title}</h2>
        <div class="mt-4 space-y-3 text-base leading-relaxed text-grafite/75">
          {body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {reasons.map((reason) => (
            <li class="rounded-2xl border border-nevoa bg-gelo p-4 text-sm font-semibold leading-snug text-petroleo">{reason}</li>
          ))}
        </ul>
        <p class="mt-5 rounded-2xl bg-petroleo p-5 text-lg font-semibold leading-snug text-white">{highlight}</p>
      </div>
    </div>
  </div>
</section>
