---
interface Props {
  title: string;
  highlight: string;
  body: string[];
}

const { title, highlight, body } = Astro.props;
---

<section class="px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl">
    <article class="rounded-3xl border border-confianca/20 bg-petroleo p-6 text-white shadow-2xl shadow-petroleo/15 sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
        <div>
          <h2 class="text-3xl font-bold leading-tight sm:text-4xl">{title}</h2>
          <p class="mt-5 rounded-2xl bg-white p-5 text-2xl font-bold leading-tight text-petroleo">{highlight}</p>
        </div>
        <div class="space-y-3 text-base leading-relaxed text-white/74">
          {body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </article>
  </div>
</section>
