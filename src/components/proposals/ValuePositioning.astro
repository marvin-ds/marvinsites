---
interface Props {
  eyebrow: string;
  title: string;
  body: string[];
  highlight: string[];
  layers: {
    title: string;
    body: string;
  }[];
  constellation: string[];
}

const { eyebrow, title, body, highlight, layers, constellation } = Astro.props;
---

<section class="px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl rounded-3xl border border-nevoa bg-white p-6 shadow-sm sm:p-10">
    <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">{eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-petroleo sm:text-4xl">{title}</h2>
        <div class="mt-4 space-y-3 text-base leading-relaxed text-grafite/75">
          {body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="mt-6 rounded-2xl bg-petroleo p-5 text-white">
          {highlight.map((line) => <p class="text-2xl font-bold leading-tight sm:text-3xl">{line}</p>)}
        </div>
      </div>

      <div class="space-y-5">
        <div class="rounded-3xl border border-nevoa bg-gelo p-5">
          <p class="text-center text-xs font-semibold uppercase tracking-[0.18em] text-confianca">Presença digital</p>
          <div class="mt-4 flex flex-wrap justify-center gap-2">
            {constellation.map((item) => (
              <span class="rounded-full border border-nevoa bg-white px-3 py-2 text-sm font-semibold text-petroleo">{item}</span>
            ))}
          </div>
        </div>

        <ol class="grid gap-3">
          {layers.map((layer, index) => (
            <li class="rounded-2xl border border-nevoa bg-gelo p-4">
              <div class="flex gap-4">
                <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-confianca text-sm font-bold text-white">{index + 1}</span>
                <div>
                  <h3 class="text-base font-bold uppercase tracking-[0.08em] text-petroleo">{layer.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-grafite/72">{layer.body}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
