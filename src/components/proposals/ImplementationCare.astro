---
interface Props {
  title: string;
  intro: string;
  items: {
    title: string;
    body: string;
  }[];
}

const { title, intro, items } = Astro.props;
---

<section class="px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">Implantação</p>
      <h2 class="mt-3 text-3xl font-bold leading-tight text-petroleo sm:text-4xl">{title}</h2>
      <p class="mt-4 text-base leading-relaxed text-grafite/75">{intro}</p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item) => (
        <article class="rounded-2xl border border-nevoa bg-white p-5 shadow-sm">
          <h3 class="text-base font-bold text-petroleo">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-grafite/70">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
