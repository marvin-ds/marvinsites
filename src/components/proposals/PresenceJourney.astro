---
import type { ProposalPage } from '../../data/proposals/types';

interface Props {
  recommendation: ProposalPage['recommendation'];
  journey: ProposalPage['journey'];
  patientJourney: ProposalPage['patientJourney'];
  presenceMap: ProposalPage['presenceMap'];
}

const { recommendation, journey, patientJourney, presenceMap } = Astro.props;
---

<section class="px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl space-y-12">
    <div class="rounded-3xl border border-nevoa bg-white p-6 shadow-sm sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">O que estamos propondo</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight text-petroleo sm:text-4xl">{recommendation.title}</h2>
          <p class="mt-4 text-base leading-relaxed text-grafite/75">{recommendation.intro}</p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {journey.map((item, index) => (
            <article class="rounded-2xl border border-nevoa bg-gelo p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-confianca">0{index + 1}</p>
              <h3 class="mt-2 text-lg font-bold text-petroleo">{item.title}</h3>
            </article>
          ))}
        </div>
      </div>

      <div class="mt-8 grid gap-2 rounded-2xl bg-petroleo p-4 text-center text-sm font-semibold uppercase tracking-[0.12em] text-white sm:grid-cols-4 sm:text-left">
        {journey.map((item) => <span>{item.title}</span>)}
      </div>
    </div>

    <div class="rounded-3xl bg-petroleo p-6 text-white shadow-2xl shadow-petroleo/20 sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <h2 class="text-3xl font-bold leading-tight sm:text-4xl">{patientJourney.title}</h2>
          <p class="mt-4 text-base leading-relaxed text-white/76">{patientJourney.body}</p>
        </div>
        <ol class="grid gap-3">
          {patientJourney.steps.map((step, index) => (
            <li class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.08] p-4">
              <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-conversao text-sm font-bold text-white">{index + 1}</span>
              <span class="text-base font-semibold leading-snug text-white">{step}</span>
            </li>
          ))}
        </ol>
      </div>
      <p class="mt-6 rounded-2xl border border-white/10 bg-white/[0.08] p-4 text-sm leading-relaxed text-white/68">{patientJourney.note}</p>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      <article class="rounded-3xl border border-nevoa bg-white p-6 shadow-sm sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">Hoje</p>
        <p class="mt-3 text-base leading-relaxed text-grafite/72">{presenceMap.current.label}</p>
        <div class="mt-6 grid gap-3">
          {presenceMap.current.nodes.map((node) => (
            <div class="rounded-2xl border border-nevoa bg-gelo px-5 py-4 text-center font-semibold text-petroleo">{node}</div>
          ))}
        </div>
      </article>

      <article class="rounded-3xl border border-confianca/20 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-confianca">{presenceMap.organized.label}</p>
        <div class="mt-6 grid gap-3">
          <div class="grid gap-2 sm:grid-cols-2">
            {presenceMap.organized.sources.map((source) => (
              <div class="rounded-2xl border border-nevoa bg-gelo px-4 py-3 text-center text-sm font-semibold text-petroleo">{source}</div>
            ))}
          </div>
          <div class="rounded-2xl bg-petroleo px-5 py-5 text-center text-lg font-bold text-white">{presenceMap.organized.hub}</div>
          <div class="grid gap-2 sm:grid-cols-2">
            {presenceMap.organized.details.map((detail) => (
              <div class="rounded-2xl border border-nevoa bg-white px-4 py-3 text-center text-sm font-semibold text-grafite/78">{detail}</div>
            ))}
          </div>
          <div class="rounded-2xl bg-resultado px-5 py-4 text-center font-bold text-white">{presenceMap.organized.destination}</div>
        </div>
      </article>
    </div>

    <p class="rounded-2xl bg-petroleo/5 p-5 text-base leading-relaxed text-grafite/72">{presenceMap.caption}</p>
  </div>
</section>
