---
import { gerarLinkWhatsApp, WHATSAPP_NUMERO } from '../../lib/whatsapp';

interface Props {
  eyebrow: string;
  title: string;
  body: string[];
  primaryLabel: string;
  primaryMessage: string;
  secondaryLabel: string;
  secondaryMessage: string;
  contractNote: string;
}

const {
  eyebrow,
  title,
  body,
  primaryLabel,
  primaryMessage,
  secondaryLabel,
  secondaryMessage,
  contractNote,
} = Astro.props;

const primaryHref = gerarLinkWhatsApp({
  numero: WHATSAPP_NUMERO,
  mensagem: primaryMessage,
  origem: 'proposta-individual',
  nicho: 'presenca-local-profissional',
});

const secondaryHref = gerarLinkWhatsApp({
  numero: WHATSAPP_NUMERO,
  mensagem: secondaryMessage,
  origem: 'proposta-duvida',
  nicho: 'presenca-local-profissional',
});
---

<section class="bg-white px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl overflow-hidden rounded-3xl bg-petroleo text-white shadow-2xl shadow-petroleo/20">
    <div class="grid gap-8 p-6 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">{eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight sm:text-4xl">{title}</h2>
        <div class="mt-4 max-w-2xl space-y-3 text-base leading-relaxed text-white/75">
          {body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <p class="mt-5 text-sm leading-relaxed text-white/58">{contractNote}</p>
      </div>
      <div class="grid gap-3 sm:min-w-72">
        <a
          href={primaryHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center rounded-lg bg-resultado px-8 py-4 text-base font-medium text-white transition-colors duration-200 hover:bg-green-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-confianca"
          data-proposal-cta="primary"
        >
          {primaryLabel}
        </a>
        <a
          href={secondaryHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center rounded-lg border border-white/18 px-8 py-4 text-base font-medium text-white transition-colors duration-200 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-confianca"
          data-proposal-cta="secondary"
        >
          {secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>
