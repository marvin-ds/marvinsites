---
import type { ProposalPage } from '../../data/proposals/types';

interface Props {
  investment: ProposalPage['investment'];
}

const { investment } = Astro.props;
---

<section class="bg-white px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-5xl">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-conversao">{investment.eyebrow}</p>
      <h2 class="mt-3 text-4xl font-bold leading-tight text-petroleo sm:text-5xl">{investment.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-grafite/75">{investment.subtitle}</p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-[0.95fr_1.05fr]">
      <article class="rounded-3xl border border-nevoa bg-gelo p-6 sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-grafite/55">{investment.setupLabel}</p>
        {investment.commercialCondition?.enabled && (
          <p class="mt-4 inline-flex rounded-full border border-conversao/25 bg-conversao/10 px-3 py-1 text-sm font-semibold text-orange-700">
            {investment.commercialCondition.label}
          </p>
        )}
        <p class="mt-5 text-5xl font-bold tracking-normal text-petroleo sm:text-6xl">{investment.setupPrice}</p>
        <p class="mt-5 text-base leading-relaxed text-grafite/72">{investment.setupDescription}</p>
        {investment.commercialCondition?.enabled && (
          <p class="mt-5 border-t border-nevoa pt-4 text-sm leading-relaxed text-grafite/62">
            {investment.commercialCondition.note}
          </p>
        )}
      </article>

      <article class="rounded-3xl bg-petroleo p-6 text-white shadow-2xl shadow-petroleo/20 sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-white/60">{investment.monthlyLabel}</p>
        <p class="mt-5 text-5xl font-bold tracking-normal text-white sm:text-6xl">{investment.monthlyPrice}</p>
        <p class="mt-5 text-base leading-relaxed text-white/75">{investment.monthlyDescription}</p>
        <div class="mt-6 grid gap-2 sm:grid-cols-2">
          {investment.monthlyIncludes.map((item) => (
            <div class="rounded-2xl border border-white/10 bg-white/[0.08] px-4 py-3 text-sm font-semibold text-white/85">{item}</div>
          ))}
        </div>
      </article>
    </div>

    <p class="mt-5 rounded-2xl border border-nevoa bg-white p-4 text-sm leading-relaxed text-grafite/65">{investment.contractNote}</p>
  </div>
</section>
